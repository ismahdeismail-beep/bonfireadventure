# Copy this file to `.env` and edit. Nothing here is required to run the
# prototype — the defaults are safe (all contact/WhatsApp surfaces OFF).

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# --- Session --------------------------------------------------------------
# Set a long random string in any shared environment.
SESSION_SECRET=dev-insecure-change-me

# --- WhatsApp (Requirement 2 / ADR-0002) ----------------------------------
# Leave EMPTY to disable every WhatsApp surface (default; also required by
# ADR-0001 while contact surfaces are suppressed). When set, exactly one entry
# point renders, on package detail pages only.
WHATSAPP_NUMBER=
WHATSAPP_PLACEMENT=package-only

# --- Seed a staff account (optional) --------------------------------------
# Leave empty for none. The password is only used on first run.
ADMIN_HANDLE=
ADMIN_PASSWORD=

# --- Payments (optional) --------------------------------------------------
# The payment panel only renders when PAY_PAYBILL is set. Real values belong
# in `.env` or the hosting environment, never in git (ADR-0006 / ADR-0001).
PAYMENTS_ENABLED=true
PAY_NAME=
PAY_PROVIDER=M-Pesa
PAY_PAYBILL=
PAY_ACCOUNT=
PAY_ACCOUNT_LABEL=Account number

# --- Pricing (Requirement 3) ---------------------------------------------
CHILD_RATE=0.7
DEPOSIT_RATE=0.2

# --- Storage --------------------------------------------------------------
# Where accounts and bookings live.
#   supabase -> shared Supabase Postgres (bonfire_* tables). Server-side only.
#   json     -> local file (app/data/db.json).
# Leave STORE empty to auto-detect: Supabase wins when its URL + service key
# are present, otherwise the JSON file is used.
STORE=

# Shared Supabase project (see app/README.md). The SERVICE ROLE key is a
# secret: it bypasses Row Level Security. Server-side only, never committed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only used when STORE=json
# DATA_FILE=/absolute/path/to/db.json
