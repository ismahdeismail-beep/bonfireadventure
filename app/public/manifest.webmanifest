{
  "id": "/",
  "name": "Bonfire Adventures",
  "short_name": "Bonfire",
  "description": "Premium tours and travel. Packages, real booking, account tracking.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#faf7f2",
  "theme_color": "#E8420A",
  "orientation": "portrait-primary",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/favicon-32.webp", "sizes": "32x32", "type": "image/webp" }
  ],
  "shortcuts": [
    {
      "name": "Browse packages",
      "short_name": "Packages",
      "url": "/packages",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Current offers",
      "short_name": "Offers",
      "url": "/offers",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My bookings",
      "short_name": "Bookings",
      "url": "/account",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "categories": ["travel", "shopping", "business"]
}
